Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hashed build assets must never fall through to the SPA document. Returning
  # index.html for a missing JavaScript file causes a dynamic-import crash.
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # BrowserRouter routes are handled by the application shell.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Always revalidate the app shell so it cannot reference an obsolete build.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Vite fingerprints JavaScript and CSS filenames, so these are safe to cache.
  <FilesMatch "\.(js|css|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
